CC := gcc
CXX := g++
INCLUDEDIR = .
CFLAGS := -I$(INCLUDEDIR) -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -O2

IMAGE_TOOLS = asustrx addpattern untrx motorola-bin splitter3

# Every directory that is built, in build order
COMPONENTS = bff jffs2 uncramfs uncramfs-lzma cramfs-2.x cramfsswap \
	squashfs-2.1-r2 squashfs-3.0 squashfs-3.0-lzma-damn-small-variant \
	wrt_vx_imgtool $(patsubst %/Makefile,%,$(sort $(wildcard others/*/Makefile))) \
	crcalc webcomp-tools tpl-tool/src firmware-tools yaffs2utils mountcp

# The bundled tools are old third-party code, and current compilers print
# several thousand lines of warnings about them. By default only a line of
# progress is shown for each component and the compiler output is written to
# build.log. Run "make V=1" to see it instead.
all:
ifeq ($(V),1)
	$(MAKE) tools
else
	+@MAKE="$(MAKE)" ./quiet-build.sh build.log @image-tools $(COMPONENTS)
endif

image-tools: $(IMAGE_TOOLS)

tools: image-tools
	for dir in $(COMPONENTS); do $(MAKE) -C $$dir || exit 1; done

addpattern: addpattern.o
	$(CC) addpattern.o -o $@

untrx: untrx.o
	$(CXX) untrx.o -o $@

splitter3: splitter3.o
	$(CXX) splitter3.o -o $@

asustrx: asustrx.o
	$(CC) asustrx.o -o $@

motorola-bin: motorola-bin.o
	$(CC) motorola-bin.o -o $@

.PHONY: all tools image-tools clean cleanall distclean

clean:
	rm -f *.o build.log build.log.tmp
	rm -f motorola-bin
	rm -f untrx
	rm -f asustrx
	rm -f addpattern
	rm -f splitter3
	$(MAKE) -C ./jffs2 clean
	$(MAKE) -C ./squashfs-2.1-r2/ clean
	$(MAKE) -C ./squashfs-3.0 clean
	$(MAKE) -C ./squashfs-3.0-lzma-damn-small-variant clean
	$(MAKE) -C ./cramfs-2.x clean
	$(MAKE) -C ./uncramfs clean
	$(MAKE) -C ./uncramfs-lzma clean
	$(MAKE) -C ./cramfsswap clean
	$(MAKE) -C ./wrt_vx_imgtool clean
	$(MAKE) -C ./others clean
	$(MAKE) -C ./crcalc clean
	$(MAKE) -C ./webcomp-tools clean
	$(MAKE) -C ./tpl-tool/src/ clean
	$(MAKE) -C ./firmware-tools/ clean
	$(MAKE) -C ./bff/ clean
	$(MAKE) -C ./yaffs2utils/ distclean
	$(MAKE) -C ./mountcp clean

cleanall: clean
	rm -rf Makefile config.* *.cache

distclean: cleanall
